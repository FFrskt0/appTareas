<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:elevation="4dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#FFFFFF"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- FRANJA DE COLOR -->
        <View
            android:id="@+id/viewEstadoColor"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:background="#F44336"/>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <!-- DESCRIPCIÓN -->
            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="15sp"
                android:textColor="#616161"
                android:layout_marginTop="5dp"/>

            <!-- ESTADO -->
            <TextView
                android:id="@+id/txtEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estado: Pendiente"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#F44336"
                android:layout_marginTop="9dp"/>

            <!-- VENCIMIENTO -->
            <TextView
                android:id="@+id/txtFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vencimiento: 10/09/2026"
                android:textSize="14sp"
                android:textColor="#616161"
                android:layout_marginTop="4dp"/>

            <!-- FECHA DE CREACIÓN -->
            <TextView
                android:id="@+id/txtFechaCreacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creada: 08/09/2026"
                android:textSize="14sp"
                android:textColor="#616161"
                android:layout_marginTop="4dp"/>

            <!-- USUARIO -->
            <TextView
                android:id="@+id/txtUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuario: Juan"
                android:textSize="14sp"
                android:textColor="#616161"
                android:layout_marginTop="4dp"/>

            <!-- BOTONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnEditar"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="EDITAR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:backgroundTint="#673AB7"
                    android:minWidth="95dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

                <Button
                    android:id="@+id/btnEliminar"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="ELIMINAR"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:backgroundTint="#673AB7"
                    android:minWidth="105dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>