<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#673AB7">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GESTOR DE TAREAS"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Administra tus actividades"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

    </LinearLayout>


    <!-- ============================= -->
    <!-- BARRA DE BÚSQUEDA -->
    <!-- ============================= -->

    <EditText
        android:id="@+id/etBuscar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_below="@id/header"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_busqueda"
        android:hint="Buscar tarea..."
        android:textColor="#212121"
        android:textColorHint="#757575"
        android:textSize="16sp"
        android:singleLine="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"/>


    <!-- ============================= -->
    <!-- FILTRO -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/filtroLayout"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_below="@id/etBuscar"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:text="Filtrar:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#30384F"/>

        <Spinner
            android:id="@+id/spinnerFiltro"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"/>

    </LinearLayout>


    <!-- ============================= -->
    <!-- ORDENAMIENTO -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/ordenLayout"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_below="@id/filtroLayout">

        <TextView
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:text="Ordenar:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#30384F"/>

        <Spinner
            android:id="@+id/spinnerOrden"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"/>

    </LinearLayout>


    <!-- ============================= -->
    <!-- LISTA DE TAREAS -->
    <!-- ============================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTareas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ordenLayout"
        android:layout_above="@+id/btnNuevaTarea"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="90dp"
        android:clipToPadding="false"/>


    <!-- ============================= -->
    <!-- BOTÓN NUEVA TAREA -->
    <!-- ============================= -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnNuevaTarea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Nueva tarea"
        android:src="@android:drawable/ic_input_add"
        android:tint="@android:color/white"
        app:backgroundTint="#673AB7"
        app:tint="@android:color/white"/>

</RelativeLayout>